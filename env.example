# Backend Environment Variables
# Copy this file to backend/.env and fill in your values

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kiosk_db

# JWT Secret (change this to a random string in production!)
JWT_SECRET=your-secret-key-change-this-in-production

# Server Port
PORT=3001

# Node Environment
NODE_ENV=development

# Telegram Bot Token (optional)
# Get it from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Frontend Environment Variables
# Copy this to frontend/.env

# API URL (for production, set to your backend URL)
# For development, leave empty to use proxy
VITE_API_URL=
